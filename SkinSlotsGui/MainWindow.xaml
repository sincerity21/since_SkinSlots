<Window x:Class="SkinSlotsGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="sincerity's Skin Re-Slotter"
        Height="940" Width="880"
        MinHeight="640" MinWidth="720"
        Background="{StaticResource WindowBg}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"
                   Text="sincerity's Skin Re-Slotter"/>
        <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource MutedText}" Margin="0,0,0,16" TextWrapping="Wrap"
                   Text="Move a skin replacer onto the next hangar slot after the skins already in the table. A skin made for slot 3 is cloned from pawn s02. Name each skin, add it to the queue, then start. Drop a pak or folder onto this window."/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="AddButton" Content="Add to queue" Padding="16,8" Margin="0,0,8,0"
                    Click="Add_Click" IsEnabled="False"/>
            <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="Start"
                    Click="Start_Click" IsEnabled="False"/>
            <ProgressBar x:Name="BusyBar" Width="120" Height="8" Margin="12,0,0,0" VerticalAlignment="Center"
                         IsIndeterminate="True" Visibility="Collapsed"/>
            <Button x:Name="ShowButton" Content="Show pak" Margin="12,0,0,0" Padding="12,6"
                    Visibility="Collapsed" Click="ShowPak_Click"/>
        </StackPanel>

        <TextBlock x:Name="ResultText" DockPanel.Dock="Bottom" Margin="0,12,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <GroupBox Header="Log" DockPanel.Dock="Bottom" Margin="0,12,0,0" Height="160"
                  Background="{StaticResource PanelBg}">
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True" FontFamily="Consolas" FontSize="12" BorderThickness="0"
                     VerticalContentAlignment="Top"/>
        </GroupBox>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <GroupBox Header="Mods" Background="{StaticResource PanelBg}" Margin="0,0,0,10" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Path" VerticalAlignment="Center"/>
                        <TextBox x:Name="ModsBox" Grid.Column="1" TextChanged="ModsBox_TextChanged"/>
                        <Button Grid.Column="2" Style="{StaticResource BrowseButton}" Content="Browse" Click="BrowseMods_Click"/>
                        <TextBlock Grid.Row="1" Text="Detected" VerticalAlignment="Top" Margin="0,12,0,0"/>
                        <TextBlock x:Name="ModStatus" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                   Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedText}"
                                   Text="The mods folder has not been scanned yet."/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Skin" Background="{StaticResource PanelBg}" Margin="0,0,0,10" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Path" VerticalAlignment="Center"/>
                        <TextBox x:Name="SourceBox" Grid.Column="1" TextChanged="SourceBox_TextChanged"/>
                        <Button Grid.Column="2" Style="{StaticResource BrowseButton}" Content="Pak" Click="BrowsePak_Click"/>
                        <Button Grid.Column="3" Style="{StaticResource BrowseButton}" Content="Folder" Click="BrowseFolder_Click"/>
                        <TextBlock Grid.Row="1" Text="Detected" VerticalAlignment="Top" Margin="0,12,0,0"/>
                        <TextBlock x:Name="PreviewText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                   Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedText}"
                                   Text="No source loaded."/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Hangar" Background="{StaticResource PanelBg}" Margin="0,0,0,10" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Language" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <ComboBox x:Name="LanguageBox" DisplayMemberPath="Name" VerticalContentAlignment="Center"
                                      SelectionChanged="LanguageBox_SelectionChanged"/>
                            <TextBlock x:Name="LanguageHint" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedText}"
                                       Text="This name and description are written into every language."/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Name" VerticalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0"/>
                        <TextBlock Grid.Row="2" Text="Description" VerticalAlignment="Top" Margin="0,12,0,0"/>
                        <TextBox x:Name="DescriptionBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="72" VerticalContentAlignment="Top"/>
                        <TextBlock Grid.Row="3" Text="Slot" VerticalAlignment="Center" Margin="0,12,0,0"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                            <CheckBox x:Name="ChooseSlotCheck" Content="Specific slot" Checked="ChooseSlotCheck_Changed" Unchecked="ChooseSlotCheck_Changed"/>
                            <TextBox x:Name="SlotBox" Width="80" Margin="12,0,0,0" TextChanged="SlotBox_TextChanged"/>
                        </StackPanel>
                        <TextBlock x:Name="SlotHint" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedText}" TextWrapping="Wrap"
                                   Text="The next slot is the number after that jet's last stock skin."/>
                        <TextBlock Grid.Row="5" Text="Instance" VerticalAlignment="Center" Margin="0,12,0,0"/>
                        <ComboBox x:Name="InstanceBox" Grid.Row="5" Grid.Column="1" Margin="0,12,0,0"
                                  DisplayMemberPath="Label" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Row="6" Text="Decal" VerticalAlignment="Center" Margin="0,12,0,0"/>
                        <ComboBox x:Name="DecalBox" Grid.Row="6" Grid.Column="1" Margin="0,12,0,0"
                                  DisplayMemberPath="Label" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Row="7" Text="Material" VerticalAlignment="Center" Margin="0,12,0,0"/>
                        <ComboBox x:Name="MaterialBox" Grid.Row="7" Grid.Column="1" Margin="0,12,0,0"
                                  DisplayMemberPath="Label" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Row="8" Text="Normal" VerticalAlignment="Center" Margin="0,12,0,0"/>
                        <ComboBox x:Name="NormalBox" Grid.Row="8" Grid.Column="1" Margin="0,12,0,0"
                                  DisplayMemberPath="Label" VerticalContentAlignment="Center"/>
                    </Grid>
                </GroupBox>

                <GroupBox x:Name="QueueBox" Header="Queue" Background="{StaticResource PanelBg}" Margin="0,0,0,10" Padding="8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <TextBlock Foreground="{StaticResource MutedText}" TextWrapping="Wrap"
                                       Text="They run from top to bottom. A skin set to the next slot uses the table after the ones above it."/>
                            <Button x:Name="RemoveButton" Content="Remove" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Padding="12,6" Click="Remove_Click" IsEnabled="False"/>
                        </StackPanel>
                        <Grid MinHeight="96">
                            <ListBox x:Name="QueueList" MaxHeight="180" BorderBrush="{StaticResource BorderBrush}"
                                     SelectionChanged="QueueList_SelectionChanged" KeyDown="QueueList_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}"/>
                                            <TextBlock Foreground="{StaticResource MutedText}" Text="{Binding Detail}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="QueueEmpty" Text="Nothing queued." Margin="8,8,0,0"
                                       Foreground="{StaticResource MutedText}" IsHitTestVisible="False"/>
                        </Grid>
                    </DockPanel>
                </GroupBox>

                <Expander Header="Paths" IsExpanded="False" Margin="0,0,0,10">
                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="UnrealPak.exe" VerticalAlignment="Center"/>
                            <TextBox x:Name="UnrealPakBox" Grid.Column="1" TextChanged="Path_TextChanged"/>
                            <Button Grid.Column="2" Style="{StaticResource BrowseButton}" Content="Browse" Click="BrowseUnrealPak_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Pawn library" VerticalAlignment="Center"/>
                            <TextBox x:Name="PawnBox" Grid.Column="1" TextChanged="Path_TextChanged"/>
                            <Button Grid.Column="2" Style="{StaticResource BrowseButton}" Content="Browse" Click="BrowsePawns_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Output pak" VerticalAlignment="Center"/>
                            <TextBox x:Name="OutputBox" Grid.Column="1"/>
                            <Button Grid.Column="2" Style="{StaticResource BrowseButton}" Content="Browse" Click="BrowseOutput_Click"/>
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
